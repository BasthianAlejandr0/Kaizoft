---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "KAIZOFT — Soluciones Tecnológicas Inteligentes" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">KAIZOFT</a>
        <ul>
          <li><a href="#quienes">Quiénes Somos</a></li>
          <li><a href="#cotiza">Cotiza con Nosotros</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <a href="/" class="logo">KAIZOFT</a>
        <nav class="footer-nav">
          <a href="#quienes">Quiénes Somos</a>
          <a href="#cotiza">Cotiza</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <p class="copy">© {new Date().getFullYear()} KAIZOFT. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --navy:    #0d1b4b;
    --blue:    #1d4ed8;
    --blue-2:  #1e40af;
    --accent:  #60a5fa;
    --white:   #ffffff;
    --text:    #1e3a8a;
    --muted:   #6b7280;
    --max:     1100px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    overflow-x: hidden;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: #fff;
    color: #111827;
  }

  /* ── NAV ── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy);
  }

  nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .logo {
    font-weight: 900;
    font-size: 1.3rem;
    color: var(--white);
    text-decoration: none;
    letter-spacing: 0.05em;
    margin-right: auto;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  ul a {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  ul a:hover { color: var(--white); }

  main { width: 100%; }

  /* ── FOOTER ── */
  footer {
    background: var(--navy);
    padding: 1.5rem 2rem;
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-nav a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s;
  }

  .footer-nav a:hover { color: #fff; }

  .copy {
    color: rgba(255,255,255,0.5);
    font-size: 0.8rem;
  }
</style>
