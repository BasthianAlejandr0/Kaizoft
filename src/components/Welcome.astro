---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<section class="hero">
  <h1>Hola, <span class="accent">{name}</span></h1>
  <p>Bienvenido a tu base de aprendizaje de Astro.</p>
  <div class="badges">
    <span>⚡ Astro 6</span>
    <span>🧩 Componentes</span>
    <span>📄 SSG</span>
  </div>
</section>

<style>
  .hero {
    padding: 3rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .accent {
    color: var(--color-primary);
  }

  p {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  span {
    background: #ede9fe;
    color: var(--color-primary);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
  }
</style>
