---

<Layout title="KAIZOFT — Soluciones Tecnológicas Inteligentes">

  <!-- ══════════════════════════════
       HERO
  ══════════════════════════════ -->
  <section class="hero">
    <div class="hero-content">
      <h1>KAIZOFT</h1>
      <p class="tagline">Soluciones Tecnológicas Inteligentes</p>
      <p class="desc">Transformamos tus ideas en software de alto rendimiento. Innovación,<br />calidad y compromiso en cada proyecto.</p>
      <div class="hero-btns">
        <a href="#cotiza" class="btn-primary">Cotiza tu Proyecto</a>
        <a href="#quienes" class="btn-outline">Conócenos</a>
      </div>
      <a href="#quienes" class="scroll-arrow" aria-label="Ir abajo">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="24" height="24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════
       QUIÉNES SOMOS
  ══════════════════════════════ -->
  <section class="section white" id="quienes">
    <div class="inner">
      <div class="section-head">
        <h2>Quiénes Somos</h2>
        <div class="underline"></div>
        <p>En KAIZOFT somos un equipo de desarrolladores y diseñadores comprometidos con la excelencia. Transformamos ideas en soluciones digitales que impulsan el crecimiento de tu negocio.</p>
      </div>

      <div class="valores-grid">
        {valores.map((v) => (
          <div class="valor-card">
            <div class="icon-box" set:html={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.description}</p>
          </div>
        ))}
      </div>

      <div class="stats-row">
        {stats.map((s) => (
          <div class="stat">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════
       COTIZA
  ══════════════════════════════ -->
  <section class="section blue" id="cotiza">
    <div class="inner">
      <div class="section-head light">
        <h2>Cotiza con Nosotros</h2>
        <div class="underline"></div>
        <p>Selecciona los servicios que necesitas y cuéntanos sobre tu proyecto. Te enviaremos una cotización personalizada.</p>
      </div>

      <p class="servicios-label">Selecciona los servicios que te interesan</p>
      <div class="servicios-grid">
        {servicios.map((s) => (
          <label class="servicio-card">
            <input type="checkbox" name="servicio" value={s.title} />
            <div class="servicio-icon" set:html={s.icon} />
            <div>
              <strong>{s.title}</strong>
              <span>{s.desc}</span>
            </div>
          </label>
        ))}
      </div>

      <form class="cotiza-form" action="#" method="post">
        <p class="form-title">Completa tus datos</p>
        <div class="form-row">
          <div class="form-field">
            <label for="nombre">Nombre completo</label>
            <input id="nombre" type="text" name="nombre" placeholder="Tu nombre" required />
          </div>
          <div class="form-field">
            <label for="email">Correo electrónico</label>
            <input id="email" type="email" name="email" placeholder="tu@email.com" required />
          </div>
        </div>
        <div class="form-field">
          <label for="empresa">Empresa (opcional)</label>
          <input id="empresa" type="text" name="empresa" placeholder="Nombre de tu empresa" />
        </div>
        <div class="form-field">
          <label for="proyecto">Cuéntanos sobre tu proyecto</label>
          <textarea id="proyecto" name="proyecto" placeholder="Describe brevemente lo que necesitas..." rows="4" required></textarea>
        </div>
        <button type="submit" class="btn-submit">Solicitar Cotización</button>
      </form>
    </div>
  </section>

  <!-- ══════════════════════════════
       CONTACTO
  ══════════════════════════════ -->
  <section class="section white" id="contacto">
    <div class="inner">
      <div class="section-head">
        <h2>Contacto</h2>
        <div class="underline"></div>
        <p>Estamos listos para ayudarte a llevar tu proyecto al siguiente nivel. Contáctanos y conversemos sobre tus ideas.</p>
      </div>

      <div class="contacto-grid">
        {contactos.map((c) => (
          <div class="contacto-card">
            <div class="icon-box" set:html={c.icon} />
            <strong>{c.label}</strong>
            <a href={c.href}>{c.value}</a>
          </div>
        ))}
      </div>

      <div class="cta-banner">
        <h3>¿Listo para comenzar tu proyecto?</h3>
        <p>No esperes más. Da el primer paso hacia la transformación digital de tu negocio.</p>
        <a href="#cotiza" class="btn-primary">Solicitar Cotización Gratis</a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('form-cotizacion') as HTMLFormElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const body = Object.fromEntries(formData);

    const res = await fetch('/api/cotizacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      alert('¡Cotización enviada! Te contactaremos pronto.');
      form.reset();
    } else {
      alert('Hubo un error al enviar. Intenta de nuevo.');
    }
  });
</script>

<style>
  /* ── HERO ── */
  .hero {
    min-height: calc(100vh - 64px);
    background:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(135deg, #1a3bdb 0%, #1e3a8a 100%);
    background-size: 60px 60px, 60px 60px, 100% 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 4rem 2rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 700px;
  }

  .hero h1 {
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: #60a5fa;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .desc {
    color: rgba(255,255,255,0.8);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .btn-primary {
    background: #2563eb;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.15s;
  }

  .btn-primary:hover { background: #1d4ed8; }

  .btn-outline {
    border: 2px solid rgba(255,255,255,0.6);
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: border-color 0.15s;
  }

  .btn-outline:hover { border-color: #fff; }

  .scroll-arrow {
    color: rgba(255,255,255,0.6);
    margin-top: 1rem;
    transition: color 0.15s;
  }

  .scroll-arrow:hover { color: #fff; }

  /* ── SECCIONES ── */
  .section { width: 100%; }

  .section.white { background: #fff; }

  .section.blue {
    background:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(135deg, #1a3bdb 0%, #1e3a8a 100%);
    background-size: 60px 60px, 60px 60px, 100% 100%;
    color: #fff;
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  /* ── ENCABEZADOS ── */
  .section-head {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-head h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #1e3a8a;
    letter-spacing: -0.02em;
  }

  .section-head.light h2 { color: #fff; }
  .section-head.light p  { color: rgba(255,255,255,0.8); }

  .underline {
    width: 48px;
    height: 4px;
    background: #1d4ed8;
    border-radius: 2px;
  }

  .section-head p {
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 600px;
  }

  /* ── QUIÉNES SOMOS ── */
  .valores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .valor-card {
    background: #f0f4ff;
    border-radius: 12px;
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  /* ── ICON BOX compartido ── */
  .icon-box {
    width: 52px;
    height: 52px;
    background: #1d4ed8;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .icon-box svg { width: 26px; height: 26px; }

  .valor-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1e3a8a;
  }

  .valor-card p {
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.6;
  }

  /* ── STATS ── */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
